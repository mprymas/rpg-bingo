---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

if (Astro.locals.user) {
  return Astro.redirect("/dashboard");
}

const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż konto">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-foreground">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">Załóż konto</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-primary hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </div>
</Layout>
