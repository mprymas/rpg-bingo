---
import Layout from "@/layouts/Layout.astro";

if (import.meta.env.PROD) {
  return new Response("Not Found", { status: 404 });
}

const linkClass = "text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring";

const sections = [
  {
    id: "default",
    title: "default",
    description: "Stan domyślny — karta skrzynki z linkiem Wróć do logowania.",
    kind: "card" as const,
    linkClass,
  },
  {
    id: "focus",
    title: "hover / focus",
    description: "Ten sam link z wymuszonym podkreśleniem i pierścieniem, żeby hover i focus były widoczne na zrzucie.",
    kind: "card" as const,
    linkClass: `${linkClass} underline ring-2 ring-ring`,
  },
  {
    id: "disabled",
    title: "disabled",
    description: "N/A — link nie jest akcją w toku.",
    kind: "na" as const,
  },
  {
    id: "error",
    title: "error",
    description: "N/A — błędy rejestracji zostają na /auth/signup?error=, a ta strona nie czyta parametru błędu.",
    kind: "na" as const,
  },
  {
    id: "empty",
    title: "empty",
    description: "N/A — strona to jeden komunikat, nie kolekcja.",
    kind: "na" as const,
  },
  {
    id: "loading",
    title: "loading",
    description: "N/A — frontmatter nie pobiera danych.",
    kind: "na" as const,
  },
];
---

<Layout title="Kitchen sink — Sprawdź swoją skrzynkę">
  <div class="bg-background min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-2xl space-y-10">
      <header class="space-y-2">
        <p class="text-muted-foreground text-sm">Dev only · /auth/confirm-email/kitchen-sink</p>
        <h1 class="text-foreground text-3xl font-bold">Kitchen sink — Sprawdź swoją skrzynkę</h1>
        <p class="text-muted-foreground text-sm">Galeria stanów UI ekranu potwierdzenia e-mail.</p>
        <a href="/auth/confirm-email" class:list={linkClass}>
          Wróć do prawdziwego ekranu
        </a>
      </header>

      {sections.map((section) => (
        <section id={section.id} class="space-y-4" aria-labelledby={`heading-${section.id}`}>
          <div class="space-y-1">
            <h2 id={`heading-${section.id}`} class="text-foreground text-xl font-semibold">
              {section.title}
            </h2>
            <p class="text-muted-foreground text-sm">{section.description}</p>
          </div>
          {section.kind === "na" ? (
            <p class="border-border bg-card text-muted-foreground rounded-2xl border border-dashed px-4 py-6 text-sm">
              {section.description}
            </p>
          ) : (
            <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-center text-foreground">
              <h1 class="mb-3 text-2xl font-bold text-foreground">Sprawdź swoją skrzynkę</h1>
              <p class="mb-6 text-muted-foreground">
                Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.
              </p>
              <a href="/auth/signin" class:list={section.linkClass}>
                Wróć do logowania
              </a>
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>
