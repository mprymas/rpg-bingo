---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listSessionsForGm } from "@/lib/services/sessions.service";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Brak konfiguracji", { status: 500 });
}

const sessions = await listSessionsForGm(supabase, Astro.locals.user!.id);

function statusLabel(status: string) {
  return status === "active" ? "Aktywna" : "Zamknięta";
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleString("pl-PL", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}
---

<Layout title="Panel MG">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-2xl space-y-6 rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Panel MG
        </h1>
        <a
          href="/sessions/new"
          class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Nowa sesja
        </a>
      </div>

      {sessions.length === 0 ? (
        <p class="rounded-lg border border-dashed border-white/20 bg-white/5 px-4 py-8 text-center text-blue-100/70">
          Nie masz jeszcze żadnej sesji
        </p>
      ) : (
        <ul class="divide-y divide-white/10 overflow-hidden rounded-xl border border-white/10">
          {sessions.map((session) => (
            <li>
              <a
                href={`/sessions/${session.id}`}
                class="flex flex-col gap-1 px-4 py-3 transition-colors hover:bg-white/10 sm:flex-row sm:items-center sm:justify-between"
              >
                <span class="font-mono text-lg tracking-widest text-white">{session.code}</span>
                <span class="flex flex-wrap gap-3 text-sm text-blue-100/70">
                  <span>
                    {session.size}×{session.size}
                  </span>
                  <span>{statusLabel(session.status)}</span>
                  <span>{formatDate(session.created_at)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <form method="POST" action="/api/auth/signout" class="pt-2">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Wyloguj
        </button>
      </form>
    </div>
  </div>
</Layout>
