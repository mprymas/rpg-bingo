---
import Layout from "@/layouts/Layout.astro";
import GmBoard from "@/components/sessions/GmBoard";
import { Badge } from "@/components/ui/badge";
import { createClient } from "@/lib/supabase";
import { getSessionWithCells } from "@/lib/services/sessions.service";
import type { SessionWithCells } from "@/types";

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? "";

let session: SessionWithCells | null = null;
let notFound = false;
let loadError: string | null = null;

if (!UUID_RE.test(id)) {
  notFound = true;
  Astro.response.status = 404;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    return new Response("Brak konfiguracji", { status: 500 });
  }

  const user = Astro.locals.user;
  if (!user) {
    return Astro.redirect("/auth/signin");
  }

  try {
    session = await getSessionWithCells(supabase, id, user.id);
    if (!session) {
      notFound = true;
      Astro.response.status = 404;
    }
  } catch {
    loadError = "Nie udało się wczytać sesji";
    Astro.response.status = 503;
  }
}

const statusLabel = session ? (session.status === "active" ? "Aktywna" : "Zamknięta") : "";
const createdLabel = session
  ? new Date(session.created_at).toLocaleString("pl-PL", {
      dateStyle: "medium",
      timeStyle: "short",
    })
  : "";

const expectedCells = session ? session.size * session.size : 0;
const boardComplete = session ? session.cells.length === expectedCells : false;
if (session && !boardComplete) {
  Astro.response.status = 422;
}
---

{notFound ? (
  <Layout title="Sesja">
    <div class="bg-background min-h-screen p-4 sm:p-8">
      <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
        <a
          href="/dashboard"
          class="mb-6 inline-block self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
        >
          Wróć do panelu
        </a>
        <p class="text-sm text-muted-foreground">Nie znaleziono sesji</p>
      </div>
    </div>
  </Layout>
) : loadError ? (
  <Layout title="Sesja">
    <div class="bg-background min-h-screen p-4 sm:p-8">
      <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
        <a
          href="/dashboard"
          class="mb-6 inline-block self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
        >
          Wróć do panelu
        </a>
        <p class="text-sm text-destructive">{loadError}</p>
      </div>
    </div>
  </Layout>
) : (
  session && (
    <Layout title={`Sesja ${session.code}`}>
      <div class="bg-background min-h-screen p-4 sm:p-8">
        <div class="mx-auto w-full max-w-2xl space-y-8 rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
          <div class="flex flex-col gap-4">
            <a
              href="/dashboard"
              class="self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
            >
              Wróć do panelu
            </a>
            <p
              class="text-center font-mono text-4xl tracking-widest text-foreground sm:text-5xl"
              aria-label="Kod sesji"
            >
              {session.code}
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-muted-foreground">
              <span>
                {session.size}×{session.size}
              </span>
              <Badge variant="secondary">{statusLabel}</Badge>
              <span>{createdLabel}</span>
            </div>
          </div>

          {boardComplete ? (
            <GmBoard
              sessionId={session.id}
              size={session.size}
              initialCells={session.cells}
              initialPlayers={session.players}
              sessionStatus={session.status}
              client:load
            />
          ) : (
            <p class="rounded-lg border border-dashed border-border px-4 py-6 text-center text-destructive">
              Nie udało się wczytać planszy (oczekiwano {expectedCells} pól, jest {session.cells.length}). Utwórz sesję
              ponownie.
            </p>
          )}
        </div>
      </div>
    </Layout>
  )
)}
