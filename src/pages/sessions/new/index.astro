---
import Layout from "@/layouts/Layout.astro";
import NewSessionForm from "@/components/sessions/NewSessionForm";
import type { NewSessionFormPrefill } from "@/components/sessions/NewSessionForm";
import { aggregateRewardCountsFromCells, isBoardSize } from "@/lib/services/session-prefill";
import { getSessionWithCells } from "@/lib/services/sessions.service";
import { createClient } from "@/lib/supabase";

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Brak konfiguracji", { status: 500 });
}

const { data: rewards, error } = await supabase
  .from("rewards")
  .select("id, slug, label, description")
  .order("created_at", { ascending: true });

const catalogError = error ? "Nie udało się wczytać nagród" : null;
if (catalogError) {
  Astro.response.status = 503;
}

let prefill: NewSessionFormPrefill | null = null;
const fromParam = Astro.url.searchParams.get("from");
const user = Astro.locals.user;

if (!catalogError && fromParam && UUID_RE.test(fromParam) && user) {
  try {
    const source = await getSessionWithCells(supabase, fromParam, user.id);
    if (source && isBoardSize(source.size)) {
      prefill = {
        size: source.size,
        rewards: aggregateRewardCountsFromCells(source.cells),
        replaceSessionId: source.id,
      };
    }
  } catch {
    // Unauthorized / missing / load failure → plain new session (ignore prefill).
  }
}
---

{catalogError ? (
  <Layout title="Nowa sesja">
    <div class="bg-background min-h-screen p-4 sm:p-8">
      <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h1 class="text-3xl font-bold text-foreground">Nowa sesja</h1>
          <a href="/dashboard" class="text-sm text-primary hover:underline">
            Wróć do panelu
          </a>
        </div>
        <p class="text-sm text-destructive">{catalogError}</p>
      </div>
    </div>
  </Layout>
) : (
  <Layout title="Nowa sesja">
    <div class="bg-background min-h-screen p-4 sm:p-8">
      <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h1 class="text-3xl font-bold text-foreground">Nowa sesja</h1>
          <a href="/dashboard" class="text-sm text-primary hover:underline">
            Wróć do panelu
          </a>
        </div>
        <NewSessionForm rewards={rewards ?? []} prefill={prefill} client:load />
      </div>
    </div>
  </Layout>
)}
