---
import Layout from "@/layouts/Layout.astro";
import JoinNickForm from "@/components/play/JoinNickForm";
import PlayerBoard from "@/components/play/PlayerBoard";
import type { PlayerBoardCell, SessionPlayerRosterEntry } from "@/types";

if (import.meta.env.PROD) {
  return new Response("Not Found", { status: 404 });
}

const rewardInspiration = { slug: "inspiration", label: "Inspiracja" };
const rewardExperience = { slug: "experience", label: "Doświadczenie" };

const PHRASES = [
  "Trafienie krytyczne",
  "Chybienie krytyczne",
  "Zaskocz przeciwników",
  "Znajdź ukryte przejście",
  "Przekonaj kupca do zniżki",
  "Uratuj sojusznika za pomocą medycyny",
  "Rozpoznaj magiczne właściwości przedmiotu",
  "Oswój zwierzę",
  "Wpadnij w pułapkę",
];

function makePlayerCells(
  count: number,
  mutate?: (cell: PlayerBoardCell, index: number) => PlayerBoardCell,
): PlayerBoardCell[] {
  return Array.from({ length: count }, (_, i) => {
    const hasReward = i % 3 === 0;
    const base: PlayerBoardCell = {
      position: i,
      phrase: PHRASES[i % PHRASES.length] ?? `Hasło ${String(i + 1)}`,
      hasReward,
      reward: null,
      claimedByColor: null,
    };
    return mutate ? mutate(base, i) : base;
  });
}

const mysteryCells = makePlayerCells(9);
const claimedRewardCells = makePlayerCells(9, (cell, i) => {
  if (i !== 0) return cell;
  return {
    ...cell,
    hasReward: true,
    reward: rewardInspiration,
    claimedByColor: 3,
  };
});
const claimedEmptyCells = makePlayerCells(9, (cell, i) => {
  if (i !== 1) return cell;
  return {
    ...cell,
    hasReward: false,
    reward: null,
    claimedByColor: 7,
  };
});
const conflictCells = makePlayerCells(9, (cell, i) => {
  if (i !== 2) return cell;
  return {
    ...cell,
    hasReward: true,
    reward: rewardExperience,
    claimedByColor: 1,
  };
});
const mixedBoardCells = makePlayerCells(9, (cell, i) => {
  if (i === 0) {
    return { ...cell, hasReward: true, reward: rewardInspiration, claimedByColor: 3 };
  }
  if (i === 1) {
    return { ...cell, hasReward: false, reward: null, claimedByColor: 7 };
  }
  if (i === 2) {
    return { ...cell, hasReward: true, reward: null, claimedByColor: null };
  }
  return cell;
});

const demoPlayers: SessionPlayerRosterEntry[] = [
  { id: "demo-p1", nick: "Anna", color: 1, created_at: "2026-09-15T14:31:00.000Z" },
  { id: "demo-p2", nick: "Borin", color: 3, created_at: "2026-09-15T14:32:00.000Z" },
  { id: "demo-p3", nick: "Cyra", color: 7, created_at: "2026-09-15T14:33:00.000Z" },
];

const nickErrorCopy = "Nick musi mieć od 1 do 24 znaków.";
const notFoundCopy = "Nie znaleziono sesji";
const loadErrorCopy = "Nie udało się wczytać sesji";
const demoNick = "Anna";
const nickSwatchClass = "text-player-3";

const sections = [
  {
    id: "nick-empty",
    title: "nick form — empty",
    description: "Formularz nicka bez prefillu.",
    kind: "nick" as const,
    prefill: "",
    nickError: false,
  },
  {
    id: "nick-prefilled",
    title: "nick form — prefilled",
    description: "Formularz nicka z zapamiętanym nickiem.",
    kind: "nick" as const,
    prefill: demoNick,
    nickError: false,
  },
  {
    id: "nick-error",
    title: "nick form — error",
    description: `Błąd walidacji nicka — „${nickErrorCopy}”.`,
    kind: "nick" as const,
    prefill: "",
    nickError: true,
  },
  {
    id: "board",
    title: "board — mixed states",
    description: "Plansza gracza: mystery frame, zajęte z nagrodą, zajęte puste, wolne bez nagrody.",
    kind: "board" as const,
    cells: mixedBoardCells,
    conflictMessage: null as string | null,
  },
  {
    id: "mystery",
    title: "mystery frame",
    description: "Niezajęte pole z nagrodą — kolorowa ramka, bez etykiety typu.",
    kind: "board" as const,
    cells: mysteryCells,
    conflictMessage: null as string | null,
  },
  {
    id: "claimed-reward",
    title: "claimed + reward",
    description: "Zajęte pole z ujawnioną etykietą nagrody i kolorem gracza.",
    kind: "board" as const,
    cells: claimedRewardCells,
    conflictMessage: null as string | null,
  },
  {
    id: "claimed-empty",
    title: "claimed empty",
    description: "Zajęte pole bez nagrody — kolor gracza, bez etykiety.",
    kind: "board" as const,
    cells: claimedEmptyCells,
    conflictMessage: null as string | null,
  },
  {
    id: "conflict",
    title: "conflict",
    description: "Komunikat „Pole jest zajęte” jako toast po przegranej rywalizacji o pole.",
    kind: "board" as const,
    cells: conflictCells,
    conflictMessage: "Pole jest zajęte",
  },
  {
    id: "not-found",
    title: "not-found",
    description: "Markup 404 (Nie znaleziono sesji). Produkcja ustawia HTTP 404; tu tylko markup.",
    kind: "not-found" as const,
  },
  {
    id: "load-error",
    title: "load error",
    description: "Markup 503 (błąd wczytania). Produkcja ustawia HTTP 503; tu tylko markup.",
    kind: "load-error" as const,
  },
];
---

<Layout title="Kitchen sink — Plansza gracza">
  <div class="bg-background min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-2xl space-y-10">
      <header class="space-y-2">
        <p class="text-muted-foreground text-sm">Dev only · /play/kitchen-sink</p>
        <h1 class="text-foreground text-3xl font-bold">Kitchen sink — Plansza gracza</h1>
        <p class="text-muted-foreground text-sm">
          Galeria stanów UI ścieżki gracza. Fixture bez żywych zapytań do bazy.
        </p>
        <a href="/" class="text-primary text-sm hover:underline">
          Wróć na stronę główną
        </a>
      </header>

      {sections.map((section) => (
        <section id={section.id} class="space-y-4" aria-labelledby={`heading-${section.id}`}>
          <div class="space-y-1">
            <h2 id={`heading-${section.id}`} class="text-foreground text-xl font-semibold">
              {section.title}
            </h2>
            <p class="text-muted-foreground text-sm">{section.description}</p>
          </div>

          {section.kind === "nick" ? (
            <div class="mx-auto w-full max-w-2xl space-y-8 rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
              <div class="flex flex-col gap-4">
                <a
                  href="/"
                  class="self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
                >
                  Wróć
                </a>
                <JoinNickForm code="PLAY01" prefill={section.prefill} nickError={section.nickError} client:load />
              </div>
            </div>
          ) : section.kind === "board" ? (
            <div class="mx-auto w-full max-w-2xl space-y-8 rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
              <div class="flex flex-col gap-4">
                <a
                  href="/"
                  class="self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
                >
                  Wróć
                </a>
                <p class:list={["text-center text-3xl font-medium break-words sm:text-4xl", nickSwatchClass]}>
                  {demoNick}
                </p>
              </div>

              <PlayerBoard
                code="PLAY01"
                size={3}
                initialCells={section.cells}
                initialPlayers={demoPlayers}
                preview
                initialConflictMessage={section.conflictMessage}
                client:load
              />
            </div>
          ) : section.kind === "not-found" ? (
            <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
              <a
                href="/"
                class="mb-6 inline-block self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
              >
                Wróć
              </a>
              <p class="text-sm text-muted-foreground">{notFoundCopy}</p>
            </div>
          ) : (
            <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
              <a
                href="/"
                class="mb-6 inline-block self-start text-sm text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
              >
                Wróć
              </a>
              <p class="text-sm text-destructive">{loadErrorCopy}</p>
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>
