---
import JoinSessionForm from "@/components/JoinSessionForm";
import DashboardActions from "@/components/dashboard/DashboardActions";
import DashboardSessionList from "@/components/dashboard/DashboardSessionList";
import type { Session } from "@/types";

interface Props {
  sessions?: Session[];
  listError?: string | null;
  /** Kitchen-sink: block real CTA navigation / sign-out */
  demo?: boolean;
  /** Kitchen-sink: force-visible focus rings on CTA, first row, sign-out */
  focusDemo?: boolean;
  /** Kitchen-sink: start with closed sessions visible */
  initialShowClosed?: boolean;
  /** Disambiguate join input ids when multiple panels mount (kitchen-sink). */
  joinInputId?: string;
}

const {
  sessions = [],
  listError = null,
  demo = false,
  focusDemo = false,
  initialShowClosed = false,
  joinInputId = "dashboard-session-code",
} = Astro.props;
---

{listError ? (
  <div class="mx-auto w-full max-w-2xl rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-bold text-foreground">Panel MG</h1>
      <DashboardActions kind="sign-out" demo={demo} client:load />
    </div>
    <p class="text-sm text-destructive">{listError}</p>
  </div>
) : (
  <div class="mx-auto w-full max-w-2xl space-y-6 rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h1 class="text-3xl font-bold text-foreground">Panel MG</h1>
      <DashboardActions kind="new-session" demo={demo} demoFocus={focusDemo} client:load />
    </div>

    <section class="space-y-3" aria-labelledby="join-session-heading">
      <h2 id="join-session-heading" class="text-lg font-semibold text-foreground">
        Dołącz do sesji
      </h2>
      <JoinSessionForm client:load demo={demo} layout="inline" inputId={joinInputId} />
    </section>

    <DashboardSessionList
      sessions={sessions}
      demo={demo}
      focusDemo={focusDemo}
      initialShowClosed={initialShowClosed}
      client:load
    />

    <DashboardActions kind="sign-out" demo={demo} demoFocus={focusDemo} client:load />
  </div>
)}
