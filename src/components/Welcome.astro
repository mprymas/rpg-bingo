---
import JoinSessionForm from "@/components/JoinSessionForm";
---

<div class="bg-background flex min-h-screen items-center justify-center p-4 sm:p-8">
  <div class="w-full max-w-sm space-y-6 rounded-2xl border border-border bg-card p-6 text-foreground sm:p-8">
    <div class="space-y-2 text-center">
      <h1 class="text-3xl font-bold text-foreground">RPG Bingo</h1>
      <p class="text-sm text-muted-foreground">
        Bingo przy stole RPG: MG układa planszę z wyzwaniami w chwilę, gracze dołączają kodem z telefonu, a nagrody
        wynikają z czytelnej reguły — nie z uznaniowej decyzji przy stole.
      </p>
    </div>

    <JoinSessionForm client:load />

    <p class="text-center text-sm text-muted-foreground">
      <a
        href="/auth/signin"
        class="text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
      >
        Zaloguj się
      </a>
      {" · "}
      <a
        href="/auth/signup"
        class="text-primary outline-none hover:underline focus-visible:ring-2 focus-visible:ring-ring"
      >
        Załóż konto
      </a>
    </p>
  </div>
</div>
