---
import { cn } from "@/lib/utils";
import { badgeVariants } from "@/components/ui/badge";
import type { SessionWithCells } from "@/types";

interface Props {
  size: number;
  cells: SessionWithCells["cells"];
}

const { size, cells } = Astro.props;

const GRID_COLS: Record<number, string> = {
  3: "grid-cols-3",
  4: "grid-cols-4",
  5: "grid-cols-5",
};
---

<div class:list={cn("mx-auto grid max-w-md gap-1", GRID_COLS[size])}>
  {cells.map((cell) => (
    <div class="flex min-h-14 flex-col justify-between rounded-md border border-border bg-card p-1.5 text-foreground sm:min-h-16 sm:p-2">
      <p class="text-xs leading-tight break-words">{cell.phrase}</p>
      {cell.reward && (
        <span class:list={cn(badgeVariants({ variant: "secondary" }), "mt-1 self-start")}>{cell.reward.label}</span>
      )}
    </div>
  ))}
</div>
