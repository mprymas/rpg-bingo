+import { describe, expect, it } from "vitest";
+import { createHttpClient, hasBaseUrl, requireBaseUrl } from "../helpers/http";
+
+describe.skipIf(!hasBaseUrl())("POST /api/sessions/title-preview — unauthenticated", () => {
+  it("returns 401 without auth", async () => {
+    const http = createHttpClient(requireBaseUrl());
+    const actual = await http.request("/api/sessions/title-preview", {
+      method: "POST",
+      json: { title: "Stół" },
+    });
+    expect(actual.status).toBe(401);
+  });
+});
