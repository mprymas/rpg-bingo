SUPABASE_URL=###
SUPABASE_KEY=###
# Sentry (optional). Copy into .env (Node) and/or .dev.vars (Cloudflare local).
# Production: set via Workers Secrets (`npx wrangler secret put SENTRY_DSN`). Never commit a real DSN.
# Without SENTRY_DSN the app boots normally; Sentry stays inactive.
SENTRY_DSN=
# Optional; tags events (e.g. local, preview, production).
# SENTRY_ENVIRONMENT=local
# Optional; primary release id (CI should set to git SHA). Falls back to CF_VERSION_METADATA when unset.
# SENTRY_RELEASE=
# Existing account for the signed-in smoke steps. Smoke does not create one.
SMOKE_EMAIL=mg.manual@rpgbingo.test
SMOKE_PASSWORD=Manual-Test-Passw0rd!
# Optional primary GM for local integration (falls back to SMOKE_* when unset).
# TEST_EMAIL=mg.manual@rpgbingo.test
# TEST_PASSWORD=Manual-Test-Passw0rd!
# Second GM for cross-owner integration / abuse cases (no SMOKE_* fallback).
TEST_EMAIL_B=mg.other@rpgbingo.test
TEST_PASSWORD_B=Other-Test-Passw0rd!
# Playwright E2E auth setup (local/preview only; never commit real values).
# Same account as SMOKE_* is fine; CI smoke job sets these to the provisioned GM.
E2E_USERNAME=mg.manual@rpgbingo.test
E2E_PASSWORD=Manual-Test-Passw0rd!
